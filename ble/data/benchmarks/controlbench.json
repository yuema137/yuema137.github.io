    "summary": {
      "en": "ControlBench measures open-ended classical-control analysis and design competence, including stability, feedback, and plot interpretation.",
      "zh": "ControlBench \u6d4b\u8bd5\u6a21\u578b\u5728\u7a33\u5b9a\u6027\u3001\u53cd\u9988\u63a7\u5236\u548c\u63a7\u5236\u56fe\u8868\u89e3\u8bfb\u7b49\u7ecf\u5178\u63a7\u5236\u5206\u6790\u4e0e\u8bbe\u8ba1\u4efb\u52a1\u4e0a\u7684\u80fd\u529b\u3002"
    },
    "task_format": {
      "en": "The model receives one of 147 undergraduate control-engineering problems and produces a zero-shot worked solution for expert review.",
      "zh": "\u6a21\u578b\u4f1a\u6536\u5230 147 \u9053\u672c\u79d1\u63a7\u5236\u5de5\u7a0b\u9898\u4e2d\u7684\u4e00\u9053\uff0c\u5e76\u751f\u6210\u7531\u9886\u57df\u4e13\u5bb6\u5ba1\u6838\u7684 zero-shot \u5b8c\u6574\u89e3\u7b54\u3002"
    },
    "scoring": {
      "metric_name": "Initial-answer accuracy",
      "explanation": {
        "en": "ACC is the fraction of the fixed 147 initial responses that control experts judge to solve the problem correctly.",
        "zh": "ACC \u662f\u56fa\u5b9a 147 \u4e2a\u521d\u59cb\u56de\u7b54\u4e2d\uff0c\u88ab\u63a7\u5236\u5de5\u7a0b\u4e13\u5bb6\u5224\u5b9a\u4e3a\u6b63\u786e\u89e3\u51b3\u95ee\u9898\u7684\u6bd4\u4f8b\u3002"
      }
