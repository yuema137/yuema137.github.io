    "summary": {
      "en": "CircuitSense tests whether multimodal models can derive equivalent symbolic equations from unseen circuit schematics and system block diagrams.",
      "zh": "CircuitSense \u6d4b\u8bd5\u591a\u6a21\u6001\u6a21\u578b\u80fd\u5426\u4ece\u672a\u89c1\u8fc7\u7684\u7535\u8def\u539f\u7406\u56fe\u548c\u7cfb\u7edf\u6846\u56fe\u4e2d\u63a8\u5bfc\u51fa\u7b49\u4ef7\u7b26\u53f7\u65b9\u7a0b\u3002"
    },
    "task_format": {
      "en": "The model receives one of 5,020 generated circuit or block diagrams and returns a symbolic nodal equation or transfer function.",
      "zh": "\u6a21\u578b\u4f1a\u6536\u5230 5,020 \u4e2a\u751f\u6210\u7535\u8def\u56fe\u6216\u7cfb\u7edf\u6846\u56fe\u4e2d\u7684\u4e00\u4e2a\uff0c\u5e76\u8fd4\u56de\u7b26\u53f7\u8282\u70b9\u65b9\u7a0b\u6216\u4f20\u9012\u51fd\u6570\u3002"
    },
    "scoring": {
      "metric_name": "Symbolic-equation accuracy",
      "explanation": {
        "en": "A response is correct when SymPy simplification or evaluation at 100 complex-frequency points proves it equivalent to the generated ground truth.",
        "zh": "\u5f53 SymPy \u5316\u7b80\u6216 100 \u4e2a\u590d\u9891\u7387\u70b9\u6570\u503c\u9a8c\u8bc1\u8bc1\u660e\u7b54\u6848\u4e0e\u751f\u6210\u6807\u51c6\u7b54\u6848\u7b49\u4ef7\u65f6\uff0c\u8be5\u9898\u7b97\u6b63\u786e\u3002"
      }
    },
