    "summary": {
      "en": "EmbodiedBench Manipulation measures whether a vision-language agent can complete simulated robot-arm manipulation through closed-loop actions.",
      "zh": "EmbodiedBench Manipulation \u6d4b\u8bd5\u89c6\u89c9\u8bed\u8a00 agent \u80fd\u5426\u901a\u8fc7\u95ed\u73af\u52a8\u4f5c\u5b8c\u6210\u6a21\u62df\u673a\u68b0\u81c2\u64cd\u4f5c\u4efb\u52a1\u3002"
    },
    "task_format": {
      "en": "The agent observes 500x500 simulator images and issues up to 15 seven-dimensional Franka-arm actions to complete one of 228 tasks.",
      "zh": "agent \u89c2\u5bdf 500\u00d7500 simulator \u56fe\u50cf\uff0c\u5e76\u53d1\u51fa\u6700\u591a 15 \u4e2a\u4e03\u7ef4 Franka \u673a\u68b0\u81c2\u52a8\u4f5c\u6765\u5b8c\u6210 228 \u4e2a task \u4e4b\u4e00\u3002"
    },
    "scoring": {
      "metric_name": "Task success rate",
      "explanation": {
        "en": "Each episode receives binary credit from its simulator-defined goal condition; the score is the percentage of 228 successful episodes.",
        "zh": "\u6bcf\u4e2a episode \u6309 simulator \u5b9a\u4e49\u7684\u76ee\u6807\u6761\u4ef6\u83b7\u5f97\u4e8c\u5143\u5206\u6570\uff0c\u6700\u7ec8\u5f97\u5206\u662f 228 \u4e2a episode \u7684\u6210\u529f\u6bd4\u4f8b\u3002"
