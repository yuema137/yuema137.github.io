    "summary": {
      "en": "LAB-Bench ProtocolQA tests whether models can diagnose and repair errors introduced into real biological laboratory protocols.",
      "zh": "LAB-Bench ProtocolQA \u6d4b\u8bd5\u6a21\u578b\u80fd\u5426\u53d1\u73b0\u771f\u5b9e\u751f\u7269\u5b9e\u9a8c protocol \u4e2d\u88ab\u5f15\u5165\u7684\u9519\u8bef\uff0c\u5e76\u9009\u62e9\u6b63\u786e\u7684\u4fee\u590d\u6b65\u9aa4\u3002"
    },
    "task_format": {
      "en": "The model reads a modified biological protocol and experimental failure, then selects the corrective action from four choices plus abstention.",
      "zh": "\u6a21\u578b\u9605\u8bfb\u88ab\u4fee\u6539\u7684\u751f\u7269\u5b9e\u9a8c protocol \u548c\u5b9e\u9a8c\u5931\u8d25\u73b0\u8c61\uff0c\u518d\u4ece\u56db\u4e2a\u4fee\u590d\u9009\u9879\u53ca abstention \u4e2d\u9009\u62e9\u7b54\u6848\u3002"
    },
    "scoring": {
      "metric_name": "Three-run full-set accuracy",
      "explanation": {
        "en": "Accuracy is the fraction of all 135 ProtocolQA questions answered correctly, averaged across three runs; abstention counts as incorrect.",
        "zh": "Accuracy \u662f 135 \u9053 ProtocolQA \u9898\u76ee\u7684\u6b63\u786e\u6bd4\u4f8b\uff0c\u5bf9\u4e09\u6b21\u8fd0\u884c\u53d6\u5e73\u5747\uff1babstention \u8ba1\u4e3a\u9519\u8bef\u3002"
      }
    },
