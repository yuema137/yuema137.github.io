    "summary": {
      "en": "OST-Bench tests whether a multimodal model can update online spatial memory as first-person observations arrive without seeing future frames.",
      "zh": "OST-Bench \u6d4b\u8bd5\u591a\u6a21\u6001\u6a21\u578b\u80fd\u5426\u968f\u7740\u7b2c\u4e00\u4eba\u79f0\u89c2\u5bdf\u5230\u8fbe\u800c\u66f4\u65b0\u5728\u7ebf\u7a7a\u95f4\u8bb0\u5fc6\uff0c\u540c\u65f6\u4e0d\u80fd\u5077\u770b\u672a\u6765\u753b\u9762\u3002"
    },
    "task_format": {
      "en": "Each dialogue round appends four or five chronological egocentric frames, and the model answers a question about the scene state at that time.",
      "zh": "\u6bcf\u8f6e\u5bf9\u8bdd\u8ffd\u52a0\u56db\u5230\u4e94\u5f20\u6309\u65f6\u95f4\u6392\u5217\u7684\u7b2c\u4e00\u4eba\u79f0\u56fe\u50cf\uff0c\u6a21\u578b\u9700\u8981\u56de\u7b54\u8be5\u65f6\u523b\u573a\u666f\u72b6\u6001\u76f8\u5173\u7684\u95ee\u9898\u3002"
    },
    "scoring": {
      "metric_name": "Multi-round overall score",
      "explanation": {
        "en": "Option accuracy, exact match, and mean relative accuracy are aggregated into the official 0-100 multi-round overall score.",
