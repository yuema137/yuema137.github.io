    "summary": {
      "en": "HealthBench tests whether models give useful and safe answers in realistic health conversations judged against physician-written criteria.",
      "zh": "HealthBench \u6d4b\u8bd5\u6a21\u578b\u80fd\u4e0d\u80fd\u5728\u771f\u5b9e\u5065\u5eb7\u5bf9\u8bdd\u4e2d\u7ed9\u51fa\u6709\u7528\u3001\u5b89\u5168\u7684\u56de\u7b54\uff0c\u5e76\u6309\u7167\u533b\u751f\u5199\u7684\u6807\u51c6\u8fdb\u884c\u8bc4\u5206\u3002"
    },
    "task_format": {
      "en": "The model receives a multi-turn conversation between a person and a health assistant, then writes the best response to the user's last message.",
      "zh": "\u6a21\u578b\u4f1a\u6536\u5230\u4e00\u6bb5\u7528\u6237\u548c health assistant \u7684\u591a\u8f6e\u5bf9\u8bdd\uff0c\u7136\u540e\u56de\u7b54\u7528\u6237\u6700\u540e\u4e00\u6761\u6d88\u606f\u3002"
    },
    "scoring": {
      "metric_name": "Physician-rubric score",
      "explanation": {
        "en": "A model-based grader checks physician-written criteria for each conversation. The score is the weighted proportion of criteria the response satisfies.",
        "zh": "model-based grader \u4f1a\u68c0\u67e5\u6bcf\u6bb5\u5bf9\u8bdd\u5bf9\u5e94\u7684\u533b\u751f\u6807\u51c6\u3002\u5206\u6570\u662f\u56de\u7b54\u6ee1\u8db3\u8fd9\u4e9b\u6807\u51c6\u7684\u52a0\u6743\u6bd4\u4f8b\u3002"
      }
    },
