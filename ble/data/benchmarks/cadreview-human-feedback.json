    "summary": {
      "en": "CADReview measures whether a multimodal model can locate and classify errors in an OpenSCAD program against intended multiview geometry.",
      "zh": "CADReview \u6d4b\u8bd5\u591a\u6a21\u6001\u6a21\u578b\u80fd\u5426\u6839\u636e\u76ee\u6807\u591a\u89c6\u56fe\u51e0\u4f55\uff0c\u5b9a\u4f4d\u5e76\u5224\u65ad OpenSCAD \u7a0b\u5e8f\u4e2d\u7684\u9519\u8bef\u3002"
    },
    "task_format": {
      "en": "The model sees correct reference renders, an erroneous block-labeled OpenSCAD program, and its render, then identifies the error block and class.",
      "zh": "\u6a21\u578b\u4f1a\u770b\u5230\u6b63\u786e\u53c2\u8003\u6e32\u67d3\u3001\u5e26 block label \u7684\u9519\u8bef OpenSCAD \u7a0b\u5e8f\u53ca\u5176\u6e32\u67d3\u56fe\uff0c\u7136\u540e\u5b9a\u4f4d\u9519\u8bef block \u5e76\u5224\u65ad\u9519\u8bef\u7c7b\u578b\u3002"
    },
    "scoring": {
      "metric_name": "Human-program feedback accuracy",
      "explanation": {
        "en": "A sample is correct only when feedback identifies both the ground-truth erroneous code block and error class; the score is mean binary accuracy on the human-written stratum.",
        "zh": "\u53ea\u6709\u53cd\u9988\u540c\u65f6\u547d\u4e2d\u6807\u51c6\u9519\u8bef\u4ee3\u7801\u5757\u548c\u9519\u8bef\u7c7b\u578b\u65f6\u6837\u672c\u624d\u7b97\u6b63\u786e\uff0c\u5206\u6570\u662f human-written stratum \u4e0a\u7684\u5e73\u5747\u4e8c\u5143\u51c6\u786e\u7387\u3002"
      }
    },
