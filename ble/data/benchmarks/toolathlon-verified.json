    },
    "scoring": {
      "metric_name": "Pass@1",
      "explanation": {
        "en": "Pass@1 is the share of tasks solved by the single submitted trajectory. The verified release also reports Pass@3 and Pass^3, but they are kept separate from the headline metric.",
